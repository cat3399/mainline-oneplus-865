# Merge with kebab_defconfig; keep normal kernel/release and DTB intact.
# IMPORTANT: Do not bump LOCALVERSION for routine fixes or rebuilds. Reuse the
# existing release unless the user explicitly requests a new version number.
CONFIG_LOCALVERSION="-kebab-x55-r5"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_DEBUG=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_MHI_BUS_SAHARA_MODEM=m
CONFIG_MHI_BUS_BL_LOGGER=y
CONFIG_MHI_BUS_CHAN_KEEPALIVE=y
CONFIG_INPUT_QPNP_POWER_ON=y
CONFIG_QCOM_ESOC=y
CONFIG_QCOM_ESOC_DEV=y
CONFIG_QCOM_ESOC_CLIENT=y
CONFIG_QCOM_ESOC_DEBUG=y
CONFIG_QCOM_ESOC_MDM_4X=y
CONFIG_QCOM_ESOC_MDM_DRV=y
CONFIG_QCOM_ESOC_DBG_ENG=y
CONFIG_QCOM_ESOC_DBG_REQ_ENG=y
CONFIG_QCOM_SYSMON=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=m
CONFIG_MHI_NET=m
CONFIG_ETHERNET=y
CONFIG_RMNET=m
CONFIG_WWAN=m
CONFIG_MHI_WWAN_CTRL=m
# CONFIG_MHI_WWAN_MBIM is not set
# Host MHI/rmnet data path first, no IPA hardware offload.
# CONFIG_QCOM_IPA is not set
CONFIG_DEBUG_FS=y
CONFIG_DYNAMIC_DEBUG=y
