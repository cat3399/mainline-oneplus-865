@@ -132,6 +132,23 @@ static int sanitize_path(const char *path)
 	return 0;
 }
 
+/* QRTR flow control can transiently reject a datagram. Never retry forever. */
+static ssize_t tftp_send_retry(int sock, const void *buf, size_t len)
+{
+	ssize_t ret;
+	unsigned int attempt;
+
+	for (attempt = 0; attempt < 100; attempt++) {
+		ret = send(sock, buf, len, MSG_DONTWAIT);
+		if (ret >= 0)
+			return ret;
+		if (errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK)
+			return ret;
+		usleep(10000);
+	}
+	return -1;
+}
+
 static int tftp_send_error(int sock, enum tftp_error code, const char *msg)
 {
 	size_t len;
@@ -148,7 +165,7 @@ static int tftp_send_error(int sock, enum tftp_error code, const char *msg)
 	*(uint16_t *)(buf + 2) = htons(code);
 	memcpy(buf + 4, msg, len - 4);
 
-	rc = send(sock, buf, len, 0);
+	rc = tftp_send_retry(sock, buf, len);
 	free(buf);
 	return rc;
 }
@@ -216,7 +233,7 @@ static ssize_t tftp_send_data(struct tftp_client *client,
 	}
 
 	log_debug("Sending %zd bytes of DATA to %d:%d\n", send_len, client->sq.sq_node, client->sq.sq_port);
-	return send(client->sock, buf, send_len, 0);
+	return tftp_send_retry(client->sock, buf, send_len);
 }
 
 
