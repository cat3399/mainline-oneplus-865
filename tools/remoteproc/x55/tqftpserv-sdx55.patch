@@ -320,7 +337,7 @@ static int tftp_send_oack(int sock, size_t *blocksize, size_t *tsize,
 		*p++ = '\0';
 	}
 
-	return send(sock, buf, p - buf, 0);
+	return tftp_send_retry(sock, buf, p - buf);
 }
 
 static int parse_options(const char *buf, size_t len, size_t *blksize,
@@ -946,7 +963,9 @@ int main(int argc, char **argv)
 		exit(1);
